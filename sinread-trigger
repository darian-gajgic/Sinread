#!/usr/bin/env python3
"""Tiny client for the Sinread app — this is what the GNOME hotkey runs.

Usage:  sinread-trigger [toggle|read|stop|pause|unload|show|status|ping|quit]

Standard library only (no venv), so it can be bound directly to a desktop shortcut.
If the app is not running, a `toggle` request starts it hidden and then reads — a hotkey
that silently does nothing would just look broken.
"""
import os
import socket
import subprocess
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SOCK = os.path.join(RUNTIME, "sinread.sock")
APP = os.path.join(os.path.dirname(os.path.realpath(__file__)), "sinread.py")
LOG_DIR = os.path.expanduser("~/.cache/sinread")


def send(cmd: str, timeout: float = 5.0) -> str | None:
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK)
        s.sendall(cmd.encode())
        reply = s.recv(4096).decode("utf-8", "replace")
        s.close()
        return reply
    except (FileNotFoundError, ConnectionRefusedError, socket.timeout, OSError):
        return None


def notify(title: str, body: str) -> None:
    try:
        subprocess.run(["notify-send", "-a", "Sinread", title, body],
                       timeout=3, check=False)
    except Exception:  # noqa: BLE001
        pass


def start_app() -> None:
    os.makedirs(LOG_DIR, exist_ok=True)
    logfile = open(os.path.join(LOG_DIR, "sinread.log"), "ab", buffering=0)
    subprocess.Popen([sys.executable, APP, "--hidden"],
                     stdout=logfile, stderr=logfile, stdin=subprocess.DEVNULL,
                     start_new_session=True)


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"

    reply = send(cmd)
    if reply is not None:
        print(reply)
        return 0

    if cmd not in ("toggle", "read", "show"):
        sys.stderr.write(f"sinread-trigger: not running (no {SOCK})\n")
        return 1

    notify("Sinread", "Starting…")
    start_app()
    deadline = time.time() + 15          # first start also probes for the Piper interpreter
    while time.time() < deadline:
        time.sleep(0.2)
        if send("ping", timeout=1) == "pong":
            reply = send(cmd)
            if reply is not None:
                print(reply)
                return 0
    notify("Sinread failed to start", f"See {LOG_DIR}/sinread.log")
    sys.stderr.write("sinread-trigger: app did not come up within 15s\n")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
